# MaskAnyone behind Apache — generated by Ansible for {{ maskanyone_hostname }}
# The MaskAnyone proxy container speaks HTTPS (self-signed) on 127.0.0.1:{{ internal_https_port }}.
# Apache terminates the real TLS certificate and forwards over HTTPS.

<VirtualHost *:80>
    ServerName {{ maskanyone_hostname }}
    RewriteEngine On
    RewriteRule ^(.*)$ https://%{HTTP_HOST}$1 [R=301,L]
</VirtualHost>

<VirtualHost *:{{ public_port }}>
    ServerName {{ maskanyone_hostname }}

    SSLEngine on
    SSLCertificateFile    {{ tls_cert_file }}
    SSLCertificateKeyFile {{ tls_key_file }}

    # Upstream is the container's self-signed certificate on localhost
    SSLProxyEngine on
    SSLProxyVerify none
    SSLProxyCheckPeerName off
    SSLProxyCheckPeerExpire off

    ProxyPreserveHost On
    ProxyPass        / https://127.0.0.1:{{ internal_https_port }}/
    ProxyPassReverse / https://127.0.0.1:{{ internal_https_port }}/

    # WebSocket upgrade (job status updates in the web app)
    RewriteEngine On
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*) wss://127.0.0.1:{{ internal_https_port }}/$1 [P,L]

    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Host  "{{ maskanyone_hostname }}"

    # Ponyland lesson: a low upload limit silently rejected multi-minute videos.
    LimitRequestBody 0
    ProxyTimeout 600

    ErrorLog  ${APACHE_LOG_DIR}/maskanyone_error.log
    CustomLog ${APACHE_LOG_DIR}/maskanyone_access.log combined
</VirtualHost>
